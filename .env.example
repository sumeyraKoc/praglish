# AI saglayicisi: GEMINI_API_KEY veya GROQ_API_KEY'den en az birini doldurun.
# Ikisi de doluysa Gemini kullanilir (mevcut/varsayilan davranis). Yalnizca
# GROQ_API_KEY doluysa (GEMINI_API_KEY bos/silinmisse) ai servisi otomatik
# olarak Groq'a gecer - boylece Gemini'de bir sorun olursa .env'de tek satir
# degistirip Groq'a gecebilirsiniz (bkz. README "AI saglayicisi" bolumu).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# Evaluator/correction her turda oyuncunun bekledigi kritik yolda calisir -
# bos birakilirsa GEMINI_MODEL ile ayni (eski davranis). Daha hafif/hizli bir
# Gemini modeli bulursaniz burada ayri ayarlayabilirsiniz.
GEMINI_EVALUATOR_MODEL=
CORRECTION_MODEL=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-transcribe
TTS_MODEL=gemini-3.1-flash-tts-preview

GROQ_API_KEY=your-groq-api-key-here
# NPC diyalogu (karakter kalitesi onemli) icin buyuk model:
GROQ_MODEL=llama-3.3-70b-versatile
# Evaluator/correction (her turda beklenen kritik yol) icin Groq'un "instant"
# (dusuk gecikmeli, kucuk) modeli - bos birakilirsa otomatik olarak
# llama-3.1-8b-instant kullanilir, GROQ_MODEL'e (70b) gore belirgin daha hizli.
GROQ_EVALUATOR_MODEL=llama-3.1-8b-instant
GROQ_CORRECTION_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

LANGUAGE_ACCEPTANCE_THRESHOLD=50
STT_MAX_AUDIO_BYTES=10485760
USE_MOCK_AI=false

# Bir turda evaluator/NPC/correction'a gonderilen konusma gecmisi bu kadar
# SATIRLA sinirlanir (en eskiler atilir) - uzun bir oda ziyaretinde prompt
# boyutunun (ve dolayisiyla yanit suresinin) sinirsiz buyumesini onler. 0 =
# sinirsiz (eski davranis).
MAX_DIALOGUE_HISTORY_TURNS=12
