# AI saglayicisi: GEMINI_API_KEY veya GROQ_API_KEY'den en az birini doldurun.
# Ikisi de doluysa Gemini kullanilir (mevcut/varsayilan davranis). Yalnizca
# GROQ_API_KEY doluysa (GEMINI_API_KEY bos/silinmisse) ai servisi otomatik
# olarak Groq'a gecer - boylece Gemini'de bir sorun olursa .env'de tek satir
# degistirip Groq'a gecebilirsiniz (bkz. README "AI saglayicisi" bolumu).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
CORRECTION_MODEL=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-transcribe
TTS_MODEL=gemini-3.1-flash-tts-preview

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CORRECTION_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

LANGUAGE_ACCEPTANCE_THRESHOLD=50
STT_MAX_AUDIO_BYTES=10485760
USE_MOCK_AI=false
